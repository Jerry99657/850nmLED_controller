CONFIG_IDF_TARGET="esp32c3"

# ESP32-C3-WROOM-02-N4：4 MB Flash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# 日志同时输出到 UART0（GPIO20/21）和 USB Serial/JTAG（GPIO18/19，仅输出）
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 主循环 5 ms 周期需要 1 ms tick
CONFIG_FREERTOS_HZ=1000

# 屏幕按当前安装方式旋转 180°
CONFIG_TFT_ROTATE_180=y

# 加入 Wi-Fi 后固件超过 1 MB，使用 1500K 应用分区（NVS 偏移不变，设置保留）
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# httpd 7+3 个 socket + 强制门户 DNS 1 个，默认 10 不够
CONFIG_LWIP_MAX_SOCKETS=16

# 降低 Wi-Fi 射频峰值电流：限制最大发射功率；欠压复位后自动再降功率
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=10
CONFIG_ESP_PHY_REDUCE_TX_POWER=y
