CONFIG_IDF_TARGET="esp32c3"

# ESP32-C3-WROOM-02-N4：4 MB Flash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# 日志同时输出到 UART0（GPIO20/21）和 USB Serial/JTAG（GPIO18/19，仅输出）
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 主循环 5 ms 周期需要 1 ms tick
CONFIG_FREERTOS_HZ=1000

# 屏幕按当前安装方式旋转 180°
CONFIG_TFT_ROTATE_180=y

# 双 OTA 分区（ota_0 / ota_1 各 1700K，无 factory）：网页在线更新固件用，见 README。
# 这张表的 nvs 分区偏移和大小与原来的 1500K 单 app 表完全一致（0x9000 / 0x6000），
# 所以换表不会丢设置。换表那一次必须整片烧写（idf.py flash），不能用 app-flash，
# 因为 otadata 要由 flash 写成 0xFF（idf.py flash 会烧 ota_data_initial.bin）。
CONFIG_PARTITION_TABLE_TWO_OTA_LARGE=y

# OTA 之后新固件要在启动后自己确认一次，否则下次上电自动退回旧版本。
# 确认点：app_main 主循环跑满 5 秒调 esp_ota_mark_app_valid_cancel_rollback()。
# 只针对 OTA 上去的固件；用数据线烧的镜像由 bootloader 直接标 VALID，不受影响。
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# httpd 7+3 个 socket + 强制门户 DNS 1 个，默认 10 不够
CONFIG_LWIP_MAX_SOCKETS=16

# 降低 Wi-Fi 射频峰值电流：限制最大发射功率；欠压复位后自动再降功率
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=10
CONFIG_ESP_PHY_REDUCE_TX_POWER=y

# 蓝牙 BLE 遥控（NimBLE，仅外设角色，不加密）
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
